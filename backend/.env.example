# ==============================================================================
# FinTrack Backend Environment Configuration
# ==============================================================================

# Server Port
PORT=3000

# MongoDB Connection String (Atlas or Local)
# Replace <username> and <password> with your MongoDB database credentials
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/fintrack?retryWrites=true&w=majority"

# JWT Secret for session tokens (Required in production)
JWT_SECRET="fintrack_jwt_dev_secret"

# GEMINI_API_KEY: Optional for server-side Gemini AI features
GEMINI_API_KEY=""

# APP_URL: The public URL of the application
APP_URL="http://localhost:3000"

# Email Authentication (Optional - if omitted, automatic simulation with in-app codes is used)
# SMTP_HOST="smtp.mailgun.org"
# SMTP_PORT=587
# SMTP_USER="postmaster@yourdomain.com"
# SMTP_PASS="your_smtp_password"
# EMAIL_FROM="FinTrack Security <noreply@fintrack.app>"
