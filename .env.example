# ==============================================================================
# FinTrack Environment Configuration (Example)
# ==============================================================================

# Server Port
PORT=3000

# MongoDB Connection String (Atlas or Local)
# Replace <username> and <password> with your MongoDB database credentials
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/fintrack?retryWrites=true&w=majority"

# JWT Secret for session tokens
JWT_SECRET="fintrack_jwt_dev_secret"

# GEMINI_API_KEY: Required for Gemini AI API calls if used.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
